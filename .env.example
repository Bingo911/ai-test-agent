# Copy to .env and edit. Every name below is a settings field read by backend/app/config.py (§15.2).
# Real credentials do not belong in this file or in git; inject them through the runtime secret store.

APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
# Only set these when something really does sit in front of this process. OFF means the forwarding
# headers are ignored entirely. When ON, FORWARDED_ALLOW_IPS must name the proxy's own address; "*" is
# refused at startup, because trusting a header any peer can write is how a client picks its own
# apparent origin (§13.3). The public URL is never rebuilt from these headers.
# PROXY_HEADERS=true
# FORWARDED_ALLOW_IPS=10.0.0.5
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO

# --- data dependencies ---------------------------------------------------------------
# SQLite is the development and test dialect; a deployment uses PostgreSQL with a psycopg3 URL.
DATABASE_URL=sqlite:///./data/ai_test_agent.db
# DATABASE_URL=postgresql+psycopg://aita:aita@127.0.0.1:5432/aita
DATA_DIR=data
# auto prefers Celery when REDIS_URL answers, and falls back to the in-process queue.
QUEUE_BACKEND=auto
REDIS_URL=redis://127.0.0.1:6379/0
OBJECT_STORE=local
# OBJECT_STORE=s3
# OBJECT_STORE_ENDPOINT=http://127.0.0.1:9000
# OBJECT_STORE_BUCKET=ai-test-agent

# --- secret storage and identity ------------------------------------------------------
SECRET_PROVIDER=local_fernet
# In production inject a Fernet master key, shared by API and workers, through your secret manager.
# SECRET_MASTER_KEY=
AUTH_MODE=dev
# Both must be replaced before APP_ENV=production, or startup refuses to run (§14.1).
DEV_ADMIN_TOKEN=dev-admin-token
DEV_ENGINEER_TOKEN=dev-engineer-token
# AUTH_MODE=oidc
# OIDC_ISSUER=https://idp.example.com/realms/aita
# OIDC_JWKS_URI=https://idp.example.com/realms/aita/protocol/openid-connect/certs

# --- execution capacity ---------------------------------------------------------------
WORKER_SLOTS=4
# The queues a Celery process serves, matching its `celery -Q`. The readiness probe cannot see a command
# line, so the default empty value means "no capacity claimed" and never "assume me" (§13.5). An
# in-process worker covers every queue and needs no value here.
# WORKER_ROLES=execution
# Cross-checked at startup: visibility > hard limit, lease TTL > 3 x heartbeat, hard limit >= active + human wait.
ACTIVE_TIMEOUT_SECONDS=300
HUMAN_WAIT_TIMEOUT_SECONDS=300
TASK_HARD_LIMIT_SECONDS=1800
VISIBILITY_TIMEOUT_SECONDS=2100
LEASE_TTL_SECONDS=30
LEASE_HEARTBEAT_SECONDS=5

# --- browser --------------------------------------------------------------------------
BROWSER_CHANNELS=chromium,chrome
BROWSER_HEADLESS=true
# Root containers have no usable setuid helper; keep this true outside them (§14.4).
BROWSER_SANDBOX=true
PLAYWRIGHT_BROWSERS_PATH=

# --- model ----------------------------------------------------------------------------
# Disabling AI leaves structured compilation, normal locating and execution untouched (§14.5).
AI_ENABLED=false
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_VISION_ENABLED=false
AI_MAX_CALLS_PER_RUN=4
AI_TIMEOUT_SECONDS=30
# Compilation has its own bounded budget: up to 200 prose steps plus one repair per step.
AI_COMPILER_MAX_CALLS=400
AI_COMPILER_MAX_TOTAL_MS=600000
# Explicit opt-in: send only a masked NORMAL screenshot of the failing step to the analysis model.
AI_ANALYSIS_IMAGES_ENABLED=false

# --- evidence -------------------------------------------------------------------------
SCREENSHOT_POLICY=on_failure
TRACE_POLICY=retain_on_failure
VIDEO_POLICY=off
ARTIFACT_MAX_BYTES=209715200
EVIDENCE_DISK_BUDGET_BYTES=209715200
ARTIFACT_ACCESS_TTL_SECONDS=60
RETENTION_NORMAL_DAYS=30
RETENTION_FAILURE_DAYS=90
RETENTION_AUDIT_DAYS=180
